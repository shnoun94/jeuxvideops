{
  "extends": "google",
  "env": {
    "browser": true,
    "node": true,
    "es6": true,
    "jest": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },

  "rules": {
    "max-len": ["error", {"code": 120}],
    "require-jsdoc": "off",
    "object-curly-spacing": ["error", "never"],
    "no-var": "off", //autorise var pour les tests unitaires
    "no_redeclare": "off", //autorise la redéclaration de variables pour les tests unitaires
    "no-undef": "off", //autorise les variables non définies pour les tests unitaires
    "no-unused-vars": "off", //autorise les variables non utilisées pour les tests unitaires
    "no-empty": "off", //autorise les blocs vides pour les tests unitaires
    "no-self-assign": "off", //autorise les auto-assignations pour les tests unitaires
    // "comma-dangle": ["error", "never"] //interdit les virgules finales
    
  }
}
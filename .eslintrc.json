{
  "extends": "google",
  "env": {
    "browser": true,
    "node": true,
    "es6": true,
    "jest": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },

  "rules": {
    "max-len": ["error", {"code": 120}],
    "require-jsdoc": "off",
    "object-curly-spacing": ["error", "never"],
    "no-var": "off",
    "no_redeclare": "off",
    "no-undef": "off",
    "no-unused-vars": "off",
    "no-empty": "off",
    "no-self-assign": "off",
    "comma-dangle": ["error", "never"]
    
  }
}